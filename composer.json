{
    "name": "laravel-ui/ux",
    "description": "Components for the Laravel UX.",
    "keywords": ["laravel", "tailwind", "livewire"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^3.3",
        "gehrisandro/tailwind-merge-php": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "LaravelUx\\Ux\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelUx\\Ux\\UxServiceProvider"
            ],
            "aliases": {
                "TailwindMerge": "LaravelUx\\Ux\\Facades\\TailwindMerge"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

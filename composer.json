{
    "name": "laravel-ux/ui",
    "description": "Components for the Laravel UX.",
    "keywords": ["laravel", "tailwind", "livewire"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-libxml": "*",
        "livewire/blaze": "^1.0@beta",
        "livewire/livewire": "^4.0@beta",
        "gehrisandro/tailwind-merge-php": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "LaravelUx\\Ui\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelUx\\Ui\\UiServiceProvider"
            ],
            "aliases": {
                "TailwindMerge": "LaravelUx\\Ui\\Facades\\TailwindMerge"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

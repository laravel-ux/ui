{
    "name": "laravel-ui/supports",
    "description": "Supports for the Laravel UI.",
    "keywords": ["laravel", "tailwind", "livewire"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^3.3",
        "gehrisandro/tailwind-merge-php": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "LaravelUi\\Supports\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelUi\\Supports\\SupportsServiceProvider"
            ],
            "aliases": {
                "TailwindMerge": "LaravelUi\\Supports\\Facades\\TailwindMerge"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
